{
  "name": "@based-labs/drand-quicknet",
  "version": "0.1.0",
  "type": "module",
  "description": "Utilities for fetching and working with drand Quicknet randomness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bas3d-Labs/drand-quicknet-evm.git",
    "directory": "packages/drand-quicknet"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
