{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    "apps/relayer": {
      "entry": [
        "src/bootstrap.ts!",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "test/**/*.ts"
      ],
      "includeEntryExports": true,
      "ignoreBinaries": [
        "flock",
        "mkfifo"
      ]
    }
  }
}