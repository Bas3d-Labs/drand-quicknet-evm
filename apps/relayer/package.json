{
  "name": "@based-labs/drand-quicknet-relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "relayer": "./scripts/relayer.sh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "QUICKNET_ENV_FILE=../../.env sh scripts/relayer.sh",
    "start:container": "sh scripts/relayer.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@based-labs/drand-quicknet": "workspace:*",
    "@based-labs/drand-quicknet-registry": "workspace:*",
    "pino": "^10.3.1",
    "viem": "^2.55.11"
  }
}