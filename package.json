{
  "name": "drand-quicknet-evm",
  "type": "module",
  "scripts": {
    "build": "pnpm build:contracts && pnpm -r build",
    "build:contracts": "forge build --root contracts",
    "build:quicknet": "pnpm --filter @based-labs/drand-quicknet build",
    "build:registry-sdk": "pnpm --filter @based-labs/drand-quicknet-registry build",
    "build:relayer": "pnpm --filter @based-labs/drand-quicknet-relayer build",
    "test": "pnpm test:contracts && pnpm -r test",
    "test:contracts": "forge test --root contracts -vvv",
    "test:quicknet": "pnpm --filter @based-labs/drand-quicknet test",
    "test:registry-sdk": "pnpm --filter @based-labs/drand-quicknet-registry test",
    "test:relayer": "pnpm --filter @based-labs/drand-quicknet-relayer test",
    "fmt": "pnpm fmt:contracts && pnpm -r fmt",
    "fmt:contracts:check": "forge fmt --root contracts --check",
    "fmt:contracts": "forge fmt --root contracts",
    "smoke:relayer": "./scripts/smoke-test-relayer.sh",
    "typecheck": "pnpm build:quicknet && pnpm build:registry-sdk && pnpm -r typecheck",
    "typecheck:quicknet": "pnpm --filter @based-labs/drand-quicknet typecheck",
    "typecheck:registry-sdk": "pnpm --filter @based-labs/drand-quicknet-registry typecheck",
    "typecheck:relayer": "pnpm --filter @based-labs/drand-quicknet-relayer typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:relayer": "pnpm build:quicknet && pnpm build:registry-sdk && pnpm test:relayer && pnpm typecheck:relayer && pnpm build:relayer"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
